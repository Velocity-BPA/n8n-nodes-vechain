{
  "name": "@velocity-bpa/n8n-nodes-vechain",
  "version": "1.0.0",
  "description": "n8n community node for VeChain blockchain interactions",
  "license": "bsl-catalog",
  "homepage": "https://github.com/velocity-bpa/n8n-nodes-vechain",
  "author": {
    "name": "Velocity BPA",
    "email": "engineering@velocity-bpa.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velocity-bpa/n8n-nodes-vechain.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials",
    "lintfix": "eslint nodes credentials --fix",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/VeChainApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/VeChain/VeChain.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "axios": "^1.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "keywords": [
    "n8n-community-node-package",
    "vechain",
    "blockchain",
    "cryptocurrency",
    "smart-contracts"
  ]
}